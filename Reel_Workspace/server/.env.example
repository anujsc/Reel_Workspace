# Local server
CLIENT_URL=http://localhost:8080
SERVER_URL=http://localhost:5000
NODE_ENV=development
PORT=5000

# Database: use a local MongoDB instance or your own Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/reelworkspace
# Optional DNS servers when the system resolver cannot resolve MongoDB SRV records
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Authentication
JWT_SECRET=replace-with-a-long-local-secret
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# AI services
GEMINI_API_KEY_TRANSCRIPT=replace-with-gemini-api-key
GEMINI_TRANSCRIPTION_MODEL=gemini-2.0-flash-exp
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=replace-with-groq-model
GROQ_VISION_MODEL=replace-with-groq-vision-model

# Media processing
USE_SOCIALKIT=true
SOCIALKIT_ACCESS_KEY=
SOCIALKIT_TIMEOUT_MS=30000
USE_YTDLP=true
USE_INSTALOADER=true

# Optional extractor command overrides
# YTDLP_EXECUTABLE=yt-dlp
PYTHON_EXECUTABLE=python3
EXTRACTOR_DOH_URL=https://cloudflare-dns.com/dns-query
# Optional HTTPS/SOCKS proxy when the local network resets Instagram TLS.
# EXTRACTOR_PROXY=http://127.0.0.1:8080

# Extraction process limits
YTDLP_TIMEOUT_MS=120000
INSTALOADER_TIMEOUT_MS=120000
EXTRACTOR_TIMEOUT_MS=120000
EXTRACT_MAX_FILE_SIZE_MB=50

# Optional Windows overrides.
# FFMPEG_PATH=C:\\path\\to\\ffmpeg.exe
# FFPROBE_PATH=C:\\path\\to\\ffprobe.exe